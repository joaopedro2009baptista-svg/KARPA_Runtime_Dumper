PRODUCT_NAME = KARPA
PRODUCT_BUNDLE_IDENTIFIER = com.example.authorized.KARPA
IPHONEOS_DEPLOYMENT_TARGET = 13.0
PLATFORM_NAME = iphoneos
ARCHS = arm64
ONLY_ACTIVE_ARCH = NO
MACH_O_TYPE = mh_dylib
DYLIB_INSTALL_NAME_BASE = @rpath
LD_DYLIB_INSTALL_NAME = @rpath/libKARPA.dylib
CLANG_ENABLE_OBJC_ARC = YES
CLANG_C_LANGUAGE_STANDARD = c11
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES
GCC_WARN_INHIBIT_ALL_WARNINGS = NO
OTHER_CFLAGS = -fobjc-arc
OTHER_LDFLAGS = $(inherited) -framework CoreGraphics
DEFINES_MODULE = NO
SKIP_INSTALL = NO

// arm64e is intentionally not forced: support depends on the selected Xcode/iOS SDK.
// An authorized device build may add ARCHS=arm64 arm64e when that SDK supports it.
